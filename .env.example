# VayuMitra Environment Configuration

# Gemini API Key (get free key at https://aistudio.google.com/)
# If left empty, VayuMitra seamlessly uses its built-in deterministic expert engine
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Application Environment
ENVIRONMENT=development
API_V1_STR=/api/v1
CORS_ORIGINS=*

# Caching & Rate Limiting
CACHE_TTL_SECONDS=900
RATE_LIMIT_PER_MINUTE=60

# Free, no-key Open-Meteo Air Quality & Geocoding URLs
OPEN_METEO_AQI_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
